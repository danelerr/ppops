{
  "name": "ppops",
  "version": "0.1.0-beta.0",
  "description": "Self-hosted, view-only RAILGUN payment reconciler",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danelerr/ppops.git"
  },
  "homepage": "https://github.com/danelerr/ppops#readme",
  "bugs": {
    "url": "https://github.com/danelerr/ppops/issues"
  },
  "keywords": [
    "railgun",
    "privacy",
    "payments",
    "reconciliation",
    "arbitrum",
    "usdc"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ppops": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run privacy:test && npm run audit:production",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "sbom": "cyclonedx-npm --ignore-npm-errors --package-lock-only --omit dev --output-reproducible --output-format JSON --output-file -",
    "privacy:report": "tsx scripts/privacy-conformance.ts",
    "privacy:test": "npm run privacy:report && vitest run test/privacy.test.ts",
    "pilot:webhook-receiver": "tsx scripts/pilot-webhook-receiver.ts",
    "kill:encrypted-leaf": "tsx scripts/encrypted-memo-leaf-gate.ts",
    "kill:export-fixture-key": "tsx scripts/export-public-fixture-viewing-key.ts",
    "kill:scan": "tsx scripts/railgun-view-only-scan.ts",
    "kill:structural": "tsx scripts/structural-gate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@railgun-community/engine": "9.6.0",
    "@railgun-community/shared-models": "8.0.1",
    "@railgun-community/wallet": "10.9.0",
    "better-sqlite3": "13.0.3",
    "ethers": "6.14.3",
    "hono": "4.13.3",
    "leveldown": "6.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/leveldown": "4.0.6",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@railgun-community/wallet": {
      "axios": "1.19.0"
    },
    "request": {
      "form-data": "2.5.6",
      "tough-cookie": "4.1.4"
    },
    "swarm-js": {
      "tar": "7.5.22"
    },
    "ws": "8.21.3",
    "qs": "6.15.3",
    "dset": "3.1.4",
    "js-yaml": "4.3.1",
    "ethjs-unit": {
      "bn.js": "4.12.3"
    },
    "number-to-bn": {
      "bn.js": "4.12.3"
    }
  }
}
