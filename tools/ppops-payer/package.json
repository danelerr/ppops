{
  "name": "ppops-payer",
  "version": "0.1.0-alpha.0",
  "description": "Reproducible RAILGUN payer harness for PPOps",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danelerr/ppops.git",
    "directory": "tools/ppops-payer"
  },
  "homepage": "https://github.com/danelerr/ppops/tree/main/tools/ppops-payer#readme",
  "bugs": {
    "url": "https://github.com/danelerr/ppops/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ppops-payer": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && npm run privacy:check && npm audit --omit=dev --audit-level=high",
    "privacy:check": "tsx scripts/privacy-check.ts"
  },
  "dependencies": {
    "@railgun-community/engine": "9.6.0",
    "@railgun-community/shared-models": "8.0.1",
    "@railgun-community/wallet": "10.9.0",
    "ethers": "6.14.3",
    "leveldown": "6.1.1",
    "snarkjs": "0.7.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/leveldown": "4.0.6",
    "@types/node": "24.10.1",
    "@types/snarkjs": "0.7.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@railgun-community/wallet": {
      "axios": "1.19.0"
    },
    "request": {
      "form-data": "2.5.6",
      "tough-cookie": "4.1.4"
    },
    "swarm-js": {
      "tar": "7.5.22"
    },
    "ws": "8.21.3",
    "qs": "6.15.3",
    "dset": "3.1.4",
    "js-yaml": "4.3.1",
    "underscore": "1.13.8",
    "ethjs-unit": {
      "bn.js": "4.12.3"
    },
    "number-to-bn": {
      "bn.js": "4.12.3"
    }
  }
}
